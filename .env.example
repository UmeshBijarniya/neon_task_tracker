# ========================================================
# Neon Classes Task Tracker - Environment Configuration
# ========================================================

# Frontend HTTP Port (Default: 80, change to 8080 or 3000 if 80 is occupied)
PORT=80

# Backend Direct Port (Default: 8000)
BACKEND_PORT=8000

# Secret key used to sign JWT authentication tokens (Change this to a random secure string in production!)
JWT_SECRET=super-secure-production-jwt-secret-replace-me

# MongoDB Connection String
MONGO_URL=mongodb://mongo:27017
DB_NAME=neon_classes

# Frontend API Base URL (leave empty when using Nginx reverse proxy on the same domain/port)
VITE_API_BASE=
